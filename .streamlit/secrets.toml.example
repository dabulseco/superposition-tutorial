# Copy this file to secrets.toml (same folder) and fill in the values.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.
# On Streamlit Community Cloud, paste these lines into the app's "Secrets" box.

OLLAMA_API_KEY = "your-key-from-ollama.com/settings/keys"
APP_PASSWORD = "a-password-for-your-class"

# Optional: offer only these cloud models (default: every model the service lists).
# OLLAMA_MODELS = "gemma4:31b, gpt-oss:120b"

# Optional: the model selected when the page opens (default: gemma4:31b).
# OLLAMA_DEFAULT_MODEL = "gemma4:31b"

# Optional, for a laptop that also runs Ollama: the app normally uses your
# local Ollama when it finds one. Uncomment to try hosted mode here.
# OLLAMA_MODE = "hosted"
